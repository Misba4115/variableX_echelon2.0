# ===========================================
# AUTONOMOUS SILVER PREDICTION AGENT
# Environment Variables Template
# ===========================================
# Copy this file to .env and fill in your values

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Metals API Configuration (for silver price data)
METALS_API_KEY=your-metals-api-key

# OpenAI Configuration (for LLM reasoning)
OPENAI_API_KEY=your-openai-api-key

# Optional: Agent Configuration
AGENT_POLL_INTERVAL=300  # seconds between data collection cycles
LOG_LEVEL=INFO
