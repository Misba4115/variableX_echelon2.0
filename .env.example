# ===========================================
# AUTONOMOUS SILVER PREDICTION AGENT
# Environment Variables Template
# ===========================================
# Copy this file to .env and fill in your values

# Real-Time Price API Keys (at least one required for real-time data)
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
FINNHUB_API_KEY=your-finnhub-key

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Mistral API (for news scraping)
MISTRAL_API_KEY=your-mistral-api-key

# Google Gemini API (for LLM predictions)
GEMINI_API_KEY=your-google-gemini-api-key

# Optional: Agent Configuration
AGENT_POLL_INTERVAL=300  # seconds between data collection cycles
LOG_LEVEL=INFO

